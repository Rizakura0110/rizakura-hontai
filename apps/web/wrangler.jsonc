{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tech-inbox-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "assets": {
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-inbox",
      "migrations_dir": "../../packages/db/migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "METADATA_QUEUE",
        "queue": "tech-inbox-metadata"
      }
    ],
    "consumers": [
      {
        "queue": "tech-inbox-metadata",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tech-inbox-metadata-dlq",
        "retry_delay": 5
      }
    ]
  },
  "services": [
    {
      "binding": "METADATA_FETCHER",
      "service": "tech-inbox-metadata-fetcher"
    }
  ]
}
