{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "tech-inbox-app",
  "main": "./src/worker/index.ts",
  "compatibility_date": "2026-08-15",
  "workers_dev": true,
  "preview_urls": false,
  "vars": {
    "ENVIRONMENT": "production",
    "APP_ORIGIN": "https://tech-inbox-app.sx7k2p9q.workers.dev"
  },
  "secrets": {
    "required": ["TEAM_DOMAIN", "POLICY_AUD", "ALLOWED_EMAIL"]
  },
  "assets": {
    "binding": "ASSETS",
    "not_found_handling": "none",
    "run_worker_first": [
      "/api",
      "/api/*",
      "/articles",
      "/articles/",
      "/settings",
      "/settings/",
      "/tech-inbox",
      "/tech-inbox/*",
      "/daymark",
      "/daymark/",
      "/daymark/index.html"
    ]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "tech-inbox",
      "database_id": "487a5705-5d37-4d80-8ff9-9a3f1aae97b3",
      "migrations_dir": "../../packages/db/migrations",
      "remote": false
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "METADATA_QUEUE",
        "queue": "tech-inbox-metadata"
      }
    ],
    "consumers": [
      {
        "queue": "tech-inbox-metadata",
        "max_batch_size": 1,
        "max_batch_timeout": 5,
        "max_retries": 3,
        "dead_letter_queue": "tech-inbox-metadata-dlq",
        "retry_delay": 5
      }
    ]
  },
  "services": [
    {
      "binding": "METADATA_FETCHER",
      "service": "tech-inbox-metadata-fetcher"
    }
  ],
  "ratelimits": [
    {
      "name": "RATE_LIMIT_CREATE",
      "namespace_id": "1001",
      "simple": { "limit": 30, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_RETRY",
      "namespace_id": "1002",
      "simple": { "limit": 10, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_MUTATE",
      "namespace_id": "1003",
      "simple": { "limit": 60, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_READ",
      "namespace_id": "1004",
      "simple": { "limit": 120, "period": 60 }
    },
    {
      "name": "RATE_LIMIT_EXPORT",
      "namespace_id": "1005",
      "simple": { "limit": 5, "period": 60 }
    }
  ]
}
