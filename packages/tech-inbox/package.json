{
  "name": "@rizakura-hontai/tech-inbox",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    "./app": "./src/app.tsx",
    "./browser": "./src/browser.ts",
    "./contracts": "./src/contracts/index.ts",
    "./core": "./src/core/index.ts",
    "./core/*": "./src/core/*.ts",
    "./server": {
      "workerd": "./src/server.ts",
      "browser": null,
      "default": "./src/server.ts"
    },
    "./schema": {
      "workerd": "./src/schema.ts",
      "browser": null,
      "default": "./src/schema.ts"
    },
    "./metadata": {
      "workerd": "./src/metadata.ts",
      "browser": null,
      "default": "./src/metadata.ts"
    }
  },
  "scripts": {
    "format:check": "biome format .",
    "lint": "biome lint .",
    "typecheck": "tsc --project tsconfig.json --noEmit && tsc --project tsconfig.test.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "build": "tsc --project tsconfig.build.json",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test:coverage && pnpm build"
  },
  "engines": {
    "node": ">=24 <25"
  },
  "packageManager": "pnpm@11.22.0",
  "dependencies": {
    "drizzle-orm": "0.45.2",
    "zod": "4.4.3"
  },
  "peerDependencies": {
    "react": "19.2.8",
    "react-router": "8.3.0"
  },
  "devDependencies": {
    "@biomejs/biome": "2.5.9",
    "@testing-library/dom": "10.4.1",
    "@testing-library/react": "16.3.2",
    "@testing-library/user-event": "14.6.5",
    "@types/node": "24.13.3",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.4",
    "@vitest/coverage-v8": "4.1.11",
    "jsdom": "30.0.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-router": "8.3.0",
    "typescript": "7.0.2",
    "vitest": "4.1.11"
  }
}
